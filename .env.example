# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.magnatravels.com

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GTM_ID=

# Optional: direct Google Ads conversion (only if NOT configuring conversions inside GTM)
# Format: AW-XXXXXXXXX and the conversion label for the lead action
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# WhatsApp number in international format without + (used for wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER=919797567990

# Server-side: where /api/enquiry forwards leads (CRM webhook, Zapier, Make, Google Apps Script, etc.)
# If empty, the API returns 503 and the form shows an error with a WhatsApp fallback (no fake success).
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent to the webhook
ENQUIRY_WEBHOOK_TOKEN=

# Optional: post the form to an external endpoint instead of the built-in /api/enquiry
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# ── Email: every enquiry is emailed to you ─────────────────────────────
# Gmail: use a 16-character "App Password" (Google Account → Security →
# 2-Step Verification → App passwords). Your normal Gmail password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=magnatravelskashmir@gmail.com
SMTP_PASS=
# Where enquiries are delivered (comma-separated). Defaults to all three business emails.
ENQUIRY_TO_EMAIL=info@magnatravels.com,magnatravelskashmir@gmail.com,ladakhtraveltrips@gmail.com
# Optional "from" address (defaults to SMTP_USER)
ENQUIRY_FROM_EMAIL=
